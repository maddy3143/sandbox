# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=AR Object Scanner API
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ar_scanner
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=ar_scanner

# ── Cache ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_key_id
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_BUCKET_NAME=ar-scanner-models
AWS_REGION=us-east-1

# ── AI APIs ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GOOGLE_VISION_API_KEY=your_google_vision_key

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project
FIREBASE_CREDENTIALS_PATH=/app/config/firebase-credentials.json

# ── 3D Reconstruction Services ────────────────────────────────────────────────
NERF_SERVICE_URL=http://nerf-service:8001
GAUSSIAN_SPLATTING_URL=http://gaussian-service:8002

# ── Call Assistant ─────────────────────────────────────────────────────────────
# Twilio (telephony) — https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx          # Your Twilio phone number

# Google Cloud (Speech-to-Text + Text-to-Speech)
# Service account JSON with roles: Cloud Speech Editor, Cloud Text-to-Speech Editor
GOOGLE_APPLICATION_CREDENTIALS=/app/config/google-credentials.json
GOOGLE_STT_CREDENTIALS_PATH=/app/config/google-credentials.json
GOOGLE_TTS_CREDENTIALS_PATH=/app/config/google-credentials.json

# Firebase Cloud Messaging (push notifications for incoming call alerts)
# Use the same Firebase project as FIREBASE_PROJECT_ID above
FCM_CREDENTIALS_PATH=/app/config/firebase-credentials.json

# Call recording encryption (AES-256 — generate with: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())")
CALL_ENCRYPTION_KEY=base64_encoded_32_byte_key_here

# Google Calendar OAuth2 — https://console.cloud.google.com/apis/credentials
GOOGLE_CALENDAR_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your_client_secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/v1/calendar/auth/google/callback

# Microsoft Outlook Calendar — https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
OUTLOOK_CLIENT_ID=your_azure_app_client_id
OUTLOOK_CLIENT_SECRET=your_azure_app_client_secret
OUTLOOK_TENANT_ID=common                  # or your specific tenant ID
OUTLOOK_REDIRECT_URI=http://localhost:8000/v1/calendar/auth/outlook/callback

# Call assistant tuning
CALL_DECISION_TIMEOUT_SECONDS=30          # How long to hold before timing out user decision
CALL_MAX_DURATION_SECONDS=600             # Max AI call duration (10 min)

# Enable mock mode for local dev (no real API keys needed)
DEV_MODE=true
